+// Portable (green build) self-update. Main downloads the release asset and
+// verifies its sha256, then a DETACHED helper swaps the asar once this process
+// is gone and relaunches it — the shape Squirrel/NSIS installers use, because
+// nothing can overwrite a bundle that is currently mapped.
+ipcMain.handle('hermes:portable-update:apply', async (_event, payload) => {
+  void prunePortableUpdateBackups().catch(() => undefined)
+
+  const result = await applyPortableUpdate(payload ?? {})
+
+  if (result.ok) {
+    // Give the renderer a beat to paint the "restarting" state before we go.
+    setTimeout(() => void exitAfterBackendShutdown(0), 1200)
+  }
+
+  return result
+})
+
 // About ▸ Updates channel selector; source checkouts only (packages bake their channel).
