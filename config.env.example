# Copy to ~/.config/hermes-desktop-pack/config.env and fill in your values.
# This file is gitignored — never commit real hosts, paths or addresses.
# Values containing spaces must be double-quoted (shell source + systemd
# EnvironmentFile both accept that).

# --- build ---
# BUILD_ROOT=$HOME/hermes-desktop-build
# REPO=$BUILD_ROOT/hermes-agent
# PATCH_DIR=$HOME/hermes-desktop-build/patches
# ART=$HOME/hermes-desktop-artifacts
# Node bin dir that provides corepack:
# NODE_BIN_DIR=$HOME/.local/share/node24/bin

# Origin baked into the client bundle; must be reachable from the Windows client.
PACK_SERVER_BASE=http://<pack-server-lan-ip>:4011

# --- deploy ---
DEPLOY_HOST=<ssh-alias-of-windows-client>
REMOTE_ASAR="D:/Program Files/HermesDesktop/resources/app.asar"
REMOTE_EXE="D:/Program Files/HermesDesktop/Hermes Agent.exe"
# Defaults derived when omitted:
# REMOTE_INCOMING="<dir of REMOTE_ASAR>/app.asar.incoming"
# TASK_NAME=HermesAgentLaunch
# WIN_PROCESS_NAME="Hermes Agent"

# --- service ---
PORT=4011
