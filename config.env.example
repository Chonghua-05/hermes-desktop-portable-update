# Copy to ~/.config/hermes-desktop-pack/config.env and fill in your values.
# This file is gitignored — never commit real hosts, paths or addresses.
# Values containing spaces must be double-quoted.

# --- build ---
# WORKSPACE=$HOME/hermes-desktop-build/hermes-agent
# PATCH_DIR=$HOME/hermes-desktop-build/patches
# ART=$HOME/hermes-desktop-artifacts
# Node bin dir that provides corepack:
# NODE_BIN_DIR=$HOME/.local/share/node24/bin

# --- release target ---
# Where the client looks for updates (baked into the bundle). Defaults to this
# repo's GitHub Releases; override only for a fork.
# RELEASE_SLUG=<owner>/<repo>
# PORTABLE_UPDATE_BASE=https://api.github.com/repos/<owner>/<repo>/releases/latest
# PORTABLE_RELEASE_URL=https://github.com/<owner>/<repo>/releases
